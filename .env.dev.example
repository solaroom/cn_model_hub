# Copy this file to .env.dev before local development.
# It is sourced by scripts/dev/*.sh, so shell variable expansion is supported.

DEV_POSTGRES_USER=hub_dev
DEV_POSTGRES_PASSWORD=hub_dev_password
DEV_POSTGRES_DB=cn_model_hub_dev

DEV_MINIO_ROOT_USER=minioadmin
DEV_MINIO_ROOT_PASSWORD=minioadmin

DEV_LAKEFS_ENCRYPT_SECRET_KEY=dev-lakefs-encrypt-key-32chars

# Public links should resolve through the main Vite dev server.
CN_MODEL_HUB_BASE_URL=http://127.0.0.1:5173
# Backend self-calls should bypass Vite and hit uvicorn directly.
CN_MODEL_HUB_INTERNAL_BASE_URL=http://127.0.0.1:48888
CN_MODEL_HUB_API_BASE=/api

CN_MODEL_HUB_DB_BACKEND=postgres
CN_MODEL_HUB_DATABASE_URL=postgresql://${DEV_POSTGRES_USER}:${DEV_POSTGRES_PASSWORD}@127.0.0.1:25432/${DEV_POSTGRES_DB}
CN_MODEL_HUB_DATABASE_KEY=dev-database-key-change-me

CN_MODEL_HUB_S3_ENDPOINT=http://127.0.0.1:29001
CN_MODEL_HUB_S3_PUBLIC_ENDPOINT=http://127.0.0.1:29001
CN_MODEL_HUB_S3_ACCESS_KEY=${DEV_MINIO_ROOT_USER}
CN_MODEL_HUB_S3_SECRET_KEY=${DEV_MINIO_ROOT_PASSWORD}
CN_MODEL_HUB_S3_BUCKET=hub-storage
CN_MODEL_HUB_S3_REGION=us-east-1

CN_MODEL_HUB_LAKEFS_ENDPOINT=http://127.0.0.1:28000
CN_MODEL_HUB_LAKEFS_REPO_NAMESPACE=hf

# L2 cache (Valkey). Default-on in dev so contributors hit cache bugs early.
# See docs/development/cache.md for the design. Disable with =false to
# verify the silent-degradation contract locally.
CN_MODEL_HUB_CACHE_ENABLED=true
CN_MODEL_HUB_CACHE_URL=redis://127.0.0.1:26379/0

# Search backend (Meilisearch). The app still falls back to database search if
# Meilisearch is disabled or unavailable.
CN_MODEL_HUB_MEILISEARCH_ENABLED=true
CN_MODEL_HUB_MEILISEARCH_URL=http://127.0.0.1:27700
CN_MODEL_HUB_MEILISEARCH_API_KEY=dev-meili-master-key

CN_MODEL_HUB_SESSION_SECRET=dev-session-secret-change-me
CN_MODEL_HUB_SESSION_EXPIRE_HOURS=168
CN_MODEL_HUB_TOKEN_EXPIRE_DAYS=365
CN_MODEL_HUB_REQUIRE_EMAIL_VERIFICATION=false
CN_MODEL_HUB_INVITATION_ONLY=false

# First backend bootstrap can auto-create fixed local demo users/orgs/repos.
CN_MODEL_HUB_DEV_AUTO_SEED=true

CN_MODEL_HUB_SITE_NAME="中文开源AI模型社区 Dev"
CN_MODEL_HUB_SPACE_RUNTIME_BACKEND=local
CN_MODEL_HUB_SPACE_RUNTIME_DIR=.space-runtimes
CN_MODEL_HUB_SPACE_RUNTIME_INSTALL_REQUIREMENTS=true
# Remote GPU runtime backend. Keep the key in your local .env.dev or shell only.
CN_MODEL_HUB_SPACE_RUNTIME_REMOTE_BASE_URL=https://uu866823-86b2-6cbcbbb3.westb.seetacloud.com:8443
CN_MODEL_HUB_SPACE_RUNTIME_REMOTE_API_KEY=
CN_MODEL_HUB_SPACE_RUNTIME_REMOTE_UPLOAD_METHOD=ssh
CN_MODEL_HUB_SPACE_RUNTIME_REMOTE_SSH_ALIAS=seeta
CN_MODEL_HUB_SPACE_RUNTIME_REMOTE_ROOT=/root/autodl-tmp/cn-model-hub-runtimes
CN_MODEL_HUB_MLFLOW_TRACKING_URI=http://127.0.0.1:25000
MLFLOW_TRACKING_URI=http://127.0.0.1:25000

# Smart assistant. Keep the real key in your local .env.dev, .env, or shell only.
CN_MODEL_HUB_ASSISTANT_LLM_API_KEY=
CN_MODEL_HUB_ASSISTANT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CN_MODEL_HUB_ASSISTANT_LLM_MODEL=qwen3.7-max
CN_MODEL_HUB_ASSISTANT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
CN_MODEL_HUB_ASSISTANT_EMBEDDING_ENABLED=true
CN_MODEL_HUB_ASSISTANT_MAX_KNOWLEDGE_CHUNKS=5

CN_MODEL_HUB_LOG_LEVEL=INFO
CN_MODEL_HUB_LOG_FORMAT=terminal
CN_MODEL_HUB_LFS_THRESHOLD_BYTES=1000000
CN_MODEL_HUB_LFS_MULTIPART_THRESHOLD_BYTES=2000000000
CN_MODEL_HUB_LFS_MULTIPART_CHUNK_SIZE_BYTES=50000000
CN_MODEL_HUB_LFS_KEEP_VERSIONS=5
CN_MODEL_HUB_LFS_AUTO_GC=true
